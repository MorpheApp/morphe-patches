<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            android:orientation="vertical"
            android:transitionGroup="true">

        <!-- Parent container for Toolbar and SearchView -->
        <FrameLayout
                android:id="@+id/morphe_toolbar_parent"
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                android:background="@android:color/white"
                android:elevation="0dp">

            <!-- Toolbar -->
            <android.support.v7.widget.Toolbar
                    android:id="@+id/morphe_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?android:attr/actionBarSize"
                    android:background="@android:color/white"
                    app:navigationIcon="@drawable/morphe_settings_toolbar_arrow_left"
                    app:title="@string/morphe_settings_title" />

            <!-- Container for SearchView -->
            <include layout="@layout/morphe_settings_search_bar" />

        </FrameLayout>

        <!-- Container for fragments -->
        <FrameLayout
                android:id="@+id/morphe_settings_fragments"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

    </LinearLayout>
</merge>
