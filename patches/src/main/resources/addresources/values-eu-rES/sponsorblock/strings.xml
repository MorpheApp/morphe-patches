  <string name="morphe_sb_segments_sponsor">Babeslea</string>
  <string name="morphe_sb_segments_sponsor_summary">Ordaindutako promozioa, ordaindutako erreferentziak eta zuzeneko iragarkiak. Ez da auto-promozioetarako edo kausen, sortzaileen, webguneen edo gustuko dituzten produktuen doako aipamenetarako</string>
  <string name="morphe_sb_segments_selfpromo">Ordaindu gabeko / Auto-promozioa</string>
  <string name="morphe_sb_segments_selfpromo_summary">Sponsorraren antzekoa, baina ordaindu gabeko edo auto-promozioetarako. Merchandising, dohaintzak edo kolaboratu duten pertsonei buruzko ataletan sartzen da</string>
  <string name="morphe_sb_segments_interaction">Elkarrekintza-gogorarazlea (harpidetu)</string>
  <string name="morphe_sb_segments_interaction_summary">Gustatu, harpidetu edo jarraitzeko gogorarazpen labur bat edukiaren erdian. Luzeagoa bada edo zerbait zehatzari buruzkoa bada, auto-promozioan egon beharko litzateke</string>
  <string name="morphe_sb_segments_highlight">Ardura</string>
  <string name="morphe_sb_segments_highlight_summary">Bideoaren zati hau da jende gehienek bilatzen dutena</string>
  <string name="morphe_sb_segments_intro">Etena / Sarrera-animazioa</string>
  <string name="morphe_sb_segments_intro_summary">Benetako edukirik gabeko tartea. Pausa bat, irudi estatiko bat edo animazio errepikatua izan daiteke. Informazioa duten trantsizioak ez dira barne</string>
  <string name="morphe_sb_segments_outro">Amaierako txartelak / Kredituak</string>
  <string name="morphe_sb_segments_outro_summary">Kredituak edo YouTube amaierako txartelak agertzen direnean. Ez da informazioa duten ondorioetarako</string>
  <string name="morphe_sb_segments_hook">Hasiera / Agurrak</string>
  <string name="morphe_sb_segments_hook_summary">Datorren bideoaren trailer narratuak, agurrak eta agur-hitzak. Eduki gehigarria gehitzen duten ataletan ez</string>
  <string name="morphe_sb_segments_preview">Aurrebista / Laburpena</string>
  <string name="morphe_sb_segments_preview_summary">Bideoan edo serie bateko beste bideoetan zer etorriko den edo zer gertatu den erakusten duten klipen bilduma, non informazio guztia beste nonbait errepikatzen den</string>
  <string name="morphe_sb_segments_filler">Tangentea / txisteak</string>
  <string name="morphe_sb_segments_filler_summary">Bideoaren eduki nagusia ulertzeko beharrezkoak ez diren tangentzial eszenak edo txisteak. Testuingurua edo atzeko planoko xehetasunak ematen dituzten ataletan ez</string>
  <string name="morphe_sb_segments_nomusic">Musika: musika ez den atala</string>
  <string name="morphe_sb_segments_nomusic_summary">Musika bideoetan soilik erabiltzeko. Musika bideoetako musikarik gabeko atalak, beste kategoriak jada hartzen ez dituenak</string>
