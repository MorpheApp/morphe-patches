  <string name="morphe_music_lyrics_show_refresh_button_summary">버튼을 탭하여 다음 가사 후보로 전환할 수 있고, 길게 탭하면 서드파티 가사를 일시적으로 비활성화하고 기본 가사를 표시할 수 있습니다</string>
  <string name="morphe_music_lyrics_saved">저장됨</string>
