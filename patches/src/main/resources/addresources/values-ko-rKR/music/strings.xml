  <string name="morphe_music_lyrics_hide_unplayed_title">재생되지 않은 가사 숨기기</string>
  <string name="morphe_music_lyrics_hide_unplayed_summary">현재 재생 중인 줄 아래의 가사 줄을 숨깁니다</string>
  <string name="morphe_music_lyrics_mediasession_title">잠금 화면에 MediaSession 가사 표시하기</string>
  <string name="morphe_music_lyrics_miniplayer_title">미니 플레이어 가사 표시하기</string>
