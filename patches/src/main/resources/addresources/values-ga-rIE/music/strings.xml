  <string name="morphe_music_lyrics_hide_unplayed_title">Folaigh liricí nár seinneadh</string>
  <string name="morphe_music_lyrics_hide_unplayed_summary">Folaigh línte na liricí faoin líne atá á seinm faoi láthair</string>
