  <string name="morphe_music_lyrics_tap_to_seek_title">I-tap ang isang linya upang maghanap</string>
  <string name="morphe_music_lyrics_tap_to_seek_summary">Ang pag-tap sa isang linya ay dadalhin ka sa sandaling iyon sa kanta</string>
  <string name="morphe_music_lyrics_show_copy_button_title">Ipakita ang button na Kopyahin</string>
  <string name="morphe_music_lyrics_show_copy_button_summary">I-tap upang kopyahin ang orihinal na lyrics bilang plain text; pindutin nang matagal upang i-save ang raw lyrics source file sa Downloads.</string>
  <string name="morphe_music_lyrics_show_translate_button_title">Ipakita ang button na Isalin</string>
  <string name="morphe_music_lyrics_show_translate_button_summary">I-tap upang i-toggle ang pagsasalin; pindutin nang matagal para sa pagsasalin lamang. Gumagamit ng mga pagsasalin mula sa provider, Google Translate, o isang API na katugma ng OpenAI.</string>
  <string name="morphe_music_lyrics_show_romanize_button_title">Ipakita ang Romanize button</string>
  <string name="morphe_music_lyrics_show_romanize_button_summary">I-tap upang i-toggle ang romanisasyon; pindutin nang matagal para sa romanisasyon lamang. Gumagamit ng romanisasyon mula sa provider, Google Translate, o isang API na katugma ng OpenAI.</string>
  <string name="morphe_music_lyrics_show_refresh_button_title">Ipakita ang button na Refresh</string>
  <string name="morphe_music_lyrics_show_refresh_button_summary">I-highlight ang mga naka-sync na salita o pantig.</string>
  <string name="morphe_music_lyrics_saved">Na-save</string>
  <string name="morphe_music_lyrics_word_sync_title">I-highlight ang mga salita o pantig na naka-sync</string>
  <string name="morphe_music_lyrics_word_sync_summary">Unahin ang word-by-word na lyrics kung available. Kapag may word timing ang lyrics, ine-highlight ang bawat salita o pantig na kasabay ng musika.</string>
  <string name="morphe_music_lyrics_hide_played_title">Itago ang linyang na-play na.</string>
  <string name="morphe_music_lyrics_hide_played_summary">Itago ang mga linya ng lyrics sa itaas ng linyang kasalukuyang pinapatugtog</string>
  <string name="morphe_music_lyrics_hide_unplayed_title">Itago ang mga lyrics na hindi pa na-play.</string>
  <string name="morphe_music_lyrics_hide_unplayed_summary">Itago ang mga linya ng lyrics sa ibaba ng screen ng kasalukuyang nagpe-play […].</string>
  <string name="morphe_music_lyrics_mediasession_title">Ipakita ang MediaSession Lyrics sa lock screen</string>
  <string name="morphe_music_lyrics_miniplayer_title">Ipakita ang Lyrics sa Miniplayer</string>
  <string name="morphe_music_lyrics_display_artist_first_title">Pagpapakita ng Artist at Pamagat […] ON \"Artist - Title\" at OFF \"Title - Artist\" — hindi ito nakakaapekto sa paghahanap ng lyrics.</string>
  <string name="morphe_music_lyrics_display_artist_first_summary">I-toggle ang pagkakasunod-sunod ng pagpapakita ng Artist at Title sa Miniplayer at MediaSession. Kapag ON: \"Artist - Title\"; kapag OFF: \"Title - Artist\". Hindi ito nakakaapekto sa paghahanap ng lyrics.</string>
  <string name="morphe_settings_music_lyrics_metadata_title">Mga Filter</string>
  <string name="morphe_music_lyrics_custom_regex_title">Regex ng filter ng lyrics</string>
  <string name="morphe_music_lyrics_custom_regex_summary">Regular expression na inilalapat sa mga pamagat, artist, at album bago maghanap ng mga liriko at kapag nagmamarka kung magkatugma ang dalawang pamagat. Iwanang blangko upang i-disable ang pareho. Ang default ay nag-aalis ng karaniwang kalat tulad ng \"Official Video\", \"Remaster\", \"【插曲】\", at \"- Topic\"</string>
  <string name="morphe_music_lyrics_text_filter_title">Regex ng filter ng lyrics</string>
  <string name="morphe_music_lyrics_text_filter_summary">Ang regular expression ay inilalapat lamang sa orihinal na teksto ng lyrics (hindi sa mga pagsasalin o romanisasyon). Iwanang blangko upang i-disable.</string>
  <string name="morphe_music_lyrics_credit_line_regex_title">Mga marker ng linya ng impormasyon</string>
  <string name="morphe_music_lyrics_credit_line_regex_summary">Kung ang mga lyrics ay hindi wastong na-filter sa ibaba, ayusin o i-clear ito. […] Iwanang blangko upang i-disable.</string>
  <string name="morphe_music_lyrics_text_size_title">Laki ng teksto</string>
  <string name="morphe_music_lyrics_text_size_summary">Laki ng teksto ng lyrics</string>
  <string name="morphe_music_lyrics_offset_ms_title">Pagkaantala ng oras</string>
  <string name="morphe_music_lyrics_offset_ms_summary">Ang naka-sync na lyrics ay sumusunod sa playback. Kung lumilihis ang mga ito, ayusin ang timing offset. […] Gumamit ng positibong halaga kung ang lyrics ay nauuna sa kanta.</string>
