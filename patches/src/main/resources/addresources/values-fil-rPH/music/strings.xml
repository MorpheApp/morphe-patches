  <string name="morphe_music_lyrics_ai_config_toast_saved">Na-save ang mga setting ng pagsasalin ng AI</string>
  <string name="morphe_music_lyrics_ai_config_toast_invalid">Hindi makakonekta sa AI endpoint. Pakisuri ang iyong mga setting.</string>
  <string name="morphe_music_lyrics_ai_config_toast_reset">Na-reset ang mga setting ng pagsasalin ng AI</string>
