  <!-- Ensure this translation matches the translation of morphe_spoof_video_streams_no_clients_suggest_vr_toast -->
  <string name="morphe_spoof_video_streams_sign_in_android_vr_about_summary">Android VR-க்கு தனி உள்நுழைவு தேவை. தொடர இங்கே தட்டவும்</string>
