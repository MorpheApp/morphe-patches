<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:yt="http://schemas.android.com/apk/res-auto"
    android:id="@+id/youtube_controls_bottom_ui_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">

    <RelativeLayout
        android:id="@+id/morphe_autoplay_button_container"
        android:layout_width="wrap_content"
        android:layout_height="60.0dip"
        yt:layout_constraintBottom_toTopOf="@+id/quick_actions_container"
        yt:layout_constraintRight_toLeftOf="@+id/fullscreen_button">

        <com.google.android.libraries.youtube.common.ui.TouchImageView
            android:id="@+id/morphe_autoplay_button"
            style="@style/YouTubePlayerButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignLeft="@+id/morphe_autoplay_button_text"
            android:layout_alignRight="@+id/morphe_autoplay_button_text"
            android:paddingTop="6.0dp"
            android:paddingBottom="0dp"
            android:scaleType="center" />

        <TextView
            android:id="@+id/morphe_autoplay_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48.0dip"
            android:paddingStart="6.0dp"
            android:paddingTop="5.5dp"
            android:paddingEnd="6.0dp"
            android:singleLine="true" />
    </RelativeLayout>
</android.support.constraint.ConstraintLayout>
