<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="icon_group"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:fillColor="@android:color/white"
                    android:pathData="M19.25 4C19.6642 4 20 4.33579 20 4.75V12.25C20 12.6642 19.6642 13 19.25 13C18.8358 13 18.5 12.6642 18.5 12.25V6.56055L6.56055 18.5H12.25C12.6642 18.5 13 18.8358 13 19.25C13 19.6642 12.6642 20 12.25 20H4.75C4.33579 20 4 19.6642 4 19.25V11.75C4 11.3358 4.33579 11 4.75 11C5.16421 11 5.5 11.3358 5.5 11.75V17.4395L17.4395 5.5H11.75C11.3358 5.5 11 5.16421 11 4.75C11 4.33579 11.3358 4 11.75 4H19.25Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="icon_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="250"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="250"
                    android:valueFrom="0.8"
                    android:valueTo="1"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
